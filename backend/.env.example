# Copy to the repo-root .env (gitignored) for local runs, or set these in your host's environment.
# Never commit real values. Never use VITE_* variables for secrets.

# --- required in production ---
SPRING_PROFILES_ACTIVE=prod,demo
SPRING_DATASOURCE_URL=jdbc:postgresql://HOST:PORT/DB
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
# base64, >= 32 bytes:  openssl rand -base64 48
JWT_SECRET=

# --- demo mode ---
APP_DEMO_ENABLED=true
DEMO_USER_PASSWORD=

# --- AI (auto = Sarvam when a key is present, otherwise rule-based offline mode) ---
AI_PROVIDER=auto
SARVAM_API_KEY=

# --- optional tuning ---
APP_ZONE=Asia/Kolkata
JWT_TTL=PT8H
ESCALATION_MANAGER_TIMEOUT=PT48H
ESCALATION_HR_TIMEOUT=PT48H
ESCALATION_POLL_INTERVAL=PT60S
# only when the frontend is served from a different origin without a proxy
APP_CORS_ALLOWED_ORIGINS=
